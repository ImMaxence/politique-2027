---
/** A single static 404 page serves both languages, so it shows both. */
import '@fontsource/anton/index.css';
import '@fontsource-variable/public-sans/index.css';
import '../styles/global.css';
import Puppet from '../components/Puppet.astro';
import { SITE } from '../config/site';
import { path } from '../i18n/routes';
import { SITE_STRINGS } from '../i18n/site';

const fr = SITE_STRINGS.fr.notFound;
const en = SITE_STRINGS.en.notFound;
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline src="/theme.js"></script>
    <title>404 — {SITE.name}</title>
    <meta name="robots" content="noindex" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  </head>
  <body>
    <main class="container section cta-final">
      <div><span class="kicker">404</span></div>
      <div class="lost" aria-hidden="true"><Puppet id="militant" camp="centre" uid="lost" size={150} /></div>
      <h1>{fr.title}</h1>
      <p>{fr.text}</p>
      <p><a class="btn btn--primary" href={path('fr', 'home')}>{fr.cta}</a></p>
      <div lang="en" class="lost-en">
        <h2>{en.title}</h2>
        <p>{en.text}</p>
        <p><a class="btn" href={path('en', 'home')}>{en.cta}</a></p>
      </div>
    </main>
  </body>
</html>

<style>
  h1 {
    font-size: clamp(2.2rem, 7vw, 4rem);
  }
  .lost {
    width: 9rem;
    margin: 0 auto 1rem;
  }
  .lost-en {
    margin-top: 3rem;
    padding-top: 2rem;
    border-top: var(--border);
  }
  .lost-en h2 {
    font-size: clamp(1.4rem, 4vw, 2rem);
  }
</style>
