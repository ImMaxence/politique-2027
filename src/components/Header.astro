---
import type { Lang } from '../i18n/game';
import { otherLang, path, type RouteKey } from '../i18n/routes';
import { SITE_STRINGS } from '../i18n/site';
import Icon from './Icon.astro';

interface Props {
  lang: Lang;
  route: RouteKey;
  /** The same page in the other language, when it is not one of the fixed routes. */
  altHref?: string;
}

const { lang, route, altHref } = Astro.props;
const t = SITE_STRINGS[lang];
const other = otherLang(lang);
const links: RouteKey[] = ['play', 'characters'];
---

<header class="header">
  <div class="container header__inner">
    <a class="logo" href={path(lang, 'home')} title={t.nav.home}>
      <span>Politique</span>{' '}<span class="logo__year">2027</span>
    </a>
    <nav class="nav" aria-label={t.nav.main}>
      <ul class="nav__list" role="list">
        {
          links.map((key) => (
            <li>
              <a href={path(lang, key)} aria-current={route === key ? 'page' : undefined}>{t.nav[key as 'play' | 'characters']}</a>
            </li>
          ))
        }
      </ul>
      <div class="nav__tools">
        <a href={altHref ?? path(other, route)} hreflang={other} lang={other} aria-label={t.nav.switchLabel}>
          <Icon name="globe" /><span>{t.nav.switchTo}</span>
        </a>
      </div>
    </nav>
  </div>
</header>
