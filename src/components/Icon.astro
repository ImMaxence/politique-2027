---
/** Hand-drawn interface icons, inlined as SVG (no icon font, no external request). */
interface Props {
  name: keyof typeof ICONS;
}

const ICONS = {
  sun: '<circle cx="12" cy="12" r="4.2"/><path d="M12 2v2.5M12 19.500V22M2 12h2.500M19.500 12H22M4.900 4.900l1.800 1.800M17.300 17.300l1.800 1.800M4.900 19.100l1.800-1.800M17.300 6.700l1.800-1.800"/>',
  moon: '<path d="M20 14.500A8.500 8.500 0 0 1 9.500 4a8.500 8.500 0 1 0 10.500 10.500z"/>',
  auto: '<circle cx="12" cy="12" r="9"/><path d="M12 3v18a9 9 0 0 0 0-18z" fill="currentColor"/>',
  globe: '<circle cx="12" cy="12" r="9"/><path d="M3 12h18M12 3c3 3.200 3 14.800 0 18M12 3c-3 3.200-3 14.800 0 18"/>',
  pause: '<path d="M8 5v14M16 5v14" stroke-width="3.4"/>',
  fast: '<path d="M4 6l8 6-8 6zM13 6l8 6-8 6z" fill="currentColor"/>',
  sound: '<path d="M4 9.500h3.500L12 5.500v13l-4.500-4H4z" fill="currentColor"/><path d="M15.500 9a4.200 4.200 0 0 1 0 6M18 6.500a7.800 7.800 0 0 1 0 11"/>',
  muted: '<path d="M4 9.500h3.500L12 5.500v13l-4.500-4H4z" fill="currentColor"/><path d="M16 9.500l5 5M21 9.500l-5 5"/>',
  fullscreen: '<path d="M4 9V4h5M15 4h5v5M20 15v5h-5M9 20H4v-5"/>',
  swap: '<path d="M4 8h13l-3.500-3.500M20 16H7l3.500 3.500"/>',
  bolt: '<path d="M13 2L5 13.500h6L10 22l9-12h-6.500z" fill="currentColor"/>',
  seal: '<path d="M6 3h9l4 4v14H6z"/><path d="M9 9h6M9 13h6M9 17c1.500-2 2.500 1.500 4 0s1.500-.800 2-1.200"/>',
  up: '<path d="M12 19V5M5.500 11.500L12 5l6.500 6.500"/>',
  phone: '<rect x="7" y="2.500" width="10" height="19" rx="2.500"/><path d="M10.500 18.500h3"/>',
} as const;

const { name } = Astro.props;
---

<svg
  viewBox="0 0 24 24"
  width="24"
  height="24"
  fill="none"
  stroke="currentColor"
  stroke-width="2.200"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
  set:html={ICONS[name]}
/>
