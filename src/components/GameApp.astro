---
/**
 * Static shell of the game. Every label is rendered at build time in the page
 * language; src/game/main.ts brings it to life.
 */
import '../styles/game.css';
import '../styles/game-side.css';
import '../styles/game-extras.css';
import { COLS, LEVELS, ROWS, levelDef } from '../game/data/levels';
import { CAMP_IDS } from '../game/data/types';
import { CAMPS, EXTRAS } from '../game/data/units';
import { ACHIEVEMENTS } from '../game/achievements';
import { VERSUS_KINDS, type VersusKind } from '../game/sim/engine';
import { GAME_STRINGS, fmt, type Lang } from '../i18n/game';
import Icon from './Icon.astro';
import Puppet from './Puppet.astro';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = GAME_STRINGS[lang];
const levels = [...LEVELS.map((l) => l.id), 0];
const cells = Array.from({ length: ROWS * COLS }, (_, i) => ({ lane: Math.floor(i / COLS), col: i % COLS }));

const kinds = Object.keys(VERSUS_KINDS) as VersusKind[];
// Soft hyphens, so that a long name breaks where it should in the narrow column.
const kindName = (k: VersusKind) =>
  (k === 'star' ? t.ui.star : t.extras[k]).replace('Éditorialiste', 'Éditoria­liste').replace('Heavyweight', 'Heavy­weight');
const kindKeys = t.ui.versusKindKeys.split(' ');
const laneKeys = t.ui.versusLaneKeys.split(' ');

/** Who turns up on a given night, in order of appearance (activists come every night and are left out). */
function castOf(id: number) {
  const level = levelDef(id);
  const extras = [...level.pool].sort((a, b) => a.from - b.from).map((p) => p.id).filter((e) => e !== 'militant');
  return [
    ...extras.map((e) => ({ id: e, name: t.extras[e], only: undefined as string | undefined })),
    ...(level.guests ?? []).map((g) => ({ id: g, name: t.figures[g].name, only: EXTRAS[g].onlyAgainst as string | undefined })),
  ];
}
---

<div class="game" id="game" data-lang={lang}>
  <!-- Phones only, outside a match: how to get the game on the home screen (shown by the script). -->
  <aside class="install-tip" data-slot="install-tip" aria-labelledby="install-title" hidden>
    <Icon name="phone" />
    <div class="install-tip__text">
      <p id="install-title" class="install-tip__title">{t.ui.installTitle}</p>
      <p data-slot="install-text"></p>
    </div>
    <button type="button" class="btn btn--primary install-tip__go" data-action="install" hidden>{t.ui.installButton}</button>
    <button type="button" class="icon-btn" data-action="dismiss-install" aria-label={t.ui.dismiss} title={t.ui.dismiss}>
      <Icon name="close" />
    </button>
  </aside>

  <!-- 1. Camp -->
  <section class="screen" data-screen="camp" aria-labelledby="camp-title">
    <div class="screen__head">
      <div>
        <h2 id="camp-title" tabindex="-1" data-focus>{t.ui.chooseCamp}</h2>
        <p>{t.ui.chooseCampHint}</p>
      </div>
    </div>
    <ul class="camps" role="list">
      {
        CAMP_IDS.map((camp) => {
          const roster = CAMPS[camp].roster;
          const faces = [roster[4], roster[1], roster[3]];
          return (
            <li>
              <button type="button" class="camp-card" data-camp={camp}>
                <span class="camp-card__head">{t.camps[camp].name}</span>
                <span class="camp-card__faces">
                  {faces.map((id) => <Puppet id={id} uid={`pick-${camp}`} size={110} />)}
                </span>
                <span class="camp-card__body">
                  <span class="camp-card__motto">{t.camps[camp].motto}</span>
                  <span class="camp-card__names">{roster.map((id) => t.figures[id].short).join(' · ')}</span>
                  <span class="trump">
                    <small>{t.ui.ultimate}</small>
                    <b>{t.ultimates[CAMPS[camp].ultimate].name}</b>
                    {t.ultimates[CAMPS[camp].ultimate].desc}
                  </span>
                  <span class="camp-card__cta">{t.ui.choose}</span>
                </span>
              </button>
            </li>
          );
        })
      }
    </ul>
  </section>

  <!-- 2. Campaign calendar -->
  <section class="screen" data-screen="levels" aria-labelledby="levels-title" hidden>
    <div class="screen__head">
      <div>
        <h2 id="levels-title" tabindex="-1" data-focus>{t.ui.chooseLevel}</h2>
        <p><span class="screen__camp" data-slot="camp-name"></span></p>
      </div>
      <div class="screen__tools">
        <div class="difficulty" role="group" aria-labelledby="difficulty-label">
          <span id="difficulty-label" class="difficulty__label">{t.ui.difficulty}</span>
          <button type="button" class="difficulty__option" data-action="difficulty" data-value="normal" aria-pressed="true">{t.ui.normal}</button>
          <button type="button" class="difficulty__option" data-action="difficulty" data-value="hard" aria-pressed="false" aria-describedby="difficulty-hint">{t.ui.hard}</button>
          <span id="difficulty-hint" class="difficulty__hint">{t.ui.hardHint}</span>
        </div>
        <button type="button" class="btn" data-action="change-camp">{t.ui.changeCamp}</button>
      </div>
    </div>
    <div class="duel-banner" data-slot="duel-banner" hidden>
      <p data-slot="duel-text"></p>
      <button type="button" class="btn btn--primary" data-action="duel-accept">{t.ui.duelAccept}</button>
    </div>
    <ol class="levels">
      {
        levels.map((id) => (
          <li>
            <button
              type="button"
              class="level-card"
              data-level={id}
            >
              <span class="level-card__date" id={`lvl-${id}-date`}>{t.levels[id].date}</span>
              <span class="level-card__name" id={`lvl-${id}-name`}>{t.levels[id].name}</span>
              <span class="level-card__blurb" id={`lvl-${id}-blurb`}>{t.levels[id].blurb}</span>
              <span class="level-card__goal" id={`lvl-${id}-goal`}><small>{t.ui.polls}</small> {t.goals[levelDef(id).goal].name}</span>
              <span class="level-card__state" id={`lvl-${id}-state`} data-slot="state" />
              <span class="level-card__cast" id={`lvl-${id}-cast`}>
                <small>{t.ui.tonight}</small>
                {
                  castOf(id).map((c) => (
                    <span class="chip" data-only={c.only}>
                      {c.name}
                    </span>
                  ))
                }
              </span>
            </button>
          </li>
        ))
      }
    </ol>

    <h3 class="modes__title">{t.ui.modesTitle}</h3>
    <ul class="levels modes" role="list">
      <li>
        <button type="button" class="level-card level-card--mode" data-mode="daily">
          <span class="level-card__date" data-slot="daily-date">★</span>
          <span class="level-card__name" id="mode-daily-name">{t.ui.dailyName}</span>
          <span class="level-card__blurb" id="mode-daily-blurb" data-slot="daily-blurb"></span>
          <span class="level-card__state" id="mode-daily-state" data-slot="daily-state">{t.ui.play}</span>
        </button>
      </li>
      <li>
        <button type="button" class="level-card level-card--mode" data-mode="duel">
          <span class="level-card__date">1 · 2</span>
          <span class="level-card__name" id="mode-duel-name">{t.ui.duelName}</span>
          <span class="level-card__blurb" id="mode-duel-blurb">{t.ui.duelBlurb}</span>
          <span class="level-card__state" id="mode-duel-state">{t.ui.play}</span>
        </button>
      </li>
      <li>
        <button type="button" class="level-card level-card--mode" data-mode="versus">
          <span class="level-card__date">1 + 2</span>
          <span class="level-card__name" id="mode-versus-name">{t.ui.versusName}</span>
          <span class="level-card__blurb" id="mode-versus-blurb">{t.ui.versusBlurb}</span>
          <span class="level-card__state" id="mode-versus-state">{t.ui.play}</span>
        </button>
      </li>
    </ul>

    <details class="achievements">
      <summary data-slot="achievements-title">{t.ui.achievementsTitle.replace('{n}', '0').replace('{total}', String(ACHIEVEMENTS.length))}</summary>
      <ul class="achievements__list" role="list">
        {
          ACHIEVEMENTS.map((id) => (
            <li data-achievement={id}>
              <b>{t.achievements[id].name}</b>
              <span>{t.achievements[id].desc}</span>
            </li>
          ))
        }
      </ul>
    </details>
  </section>

  <!-- 2b. Getting ready for a night: the deck, from night 6 -->
  <section class="screen" data-screen="team" aria-labelledby="team-title" hidden>
    <div class="screen__head">
      <div>
        <h2 id="team-title" tabindex="-1" data-focus>{t.ui.teamTitle}</h2>
        <p data-slot="team-hint"></p>
      </div>
      <div class="screen__tools">
        <button type="button" class="btn" data-action="team-back">{t.ui.teamBack}</button>
      </div>
    </div>
    <p class="team__count" data-slot="team-count" aria-live="polite"></p>
    <div class="team__filters" role="group" aria-label={t.ui.teamFilter}>
      <button type="button" class="team-filter" data-filter="all" aria-pressed="true">{t.ui.teamAll}</button>
      {(['money', 'attack', 'effect', 'defence'] as const).map((c) => (
        <button type="button" class="team-filter" data-filter={c} aria-pressed="false">{t.types[c]}</button>
      ))}
    </div>
    <h3 class="team__title">{t.ui.teamCamp}</h3>
    <ul class="team__cards" data-slot="team-camp" role="list"></ul>
    <h3 class="team__title">{t.ui.teamReinforcements}</h3>
    <ul class="team__cards" data-slot="team-reinforcements" role="list"></ul>
    <h3 class="team__title" data-slot="team-transfuges-title"></h3>
    <p class="team__explain" data-slot="team-transfuges-explain">{t.ui.teamTransfugesHint}</p>
    <div data-slot="team-transfuges"></div>
    <p class="team__go"><button type="button" class="btn btn--primary" data-action="team-go">{t.ui.teamGo}</button></p>
  </section>

  <!-- 3. Match -->
  <section class="screen" data-screen="match" aria-labelledby="match-title" hidden>
    <h2 id="match-title" class="sr-only" tabindex="-1" data-focus>{t.ui.board}</h2>
    <!--
      On a desktop the three groups below sit side by side in one toolbar. On a phone
      the cards become a column of tickets on the left and the two other groups are
      laid over the top of the board (see ".is-compact" in game.css).
    -->
    <div class="hud" data-slot="hud">
      <div class="hud__start">
        <div class="hud__res" title={t.ui.resources}>
          <Icon name="ballot" />
          <span class="sr-only">{t.ui.resources} :</span>
          <span data-slot="resources">0</span>
        </div>
      </div>
      <div class="hud__cards" role="group" aria-label={t.ui.cards} data-slot="cards"></div>
      <div data-slot="descriptions" hidden></div>
      <div class="hud__end">
        <button type="button" class="tool" data-action="remove" aria-pressed="false" aria-keyshortcuts="R" title={t.ui.reshuffleHint}>
          <Icon name="trash" />
          <span class="tool__label">{t.ui.reshuffle}</span>
        </button>
        <!-- Phone layout only: says what the next tap does while figures are being removed.
             Screen readers get the same sentence from the live region. -->
        <span class="hud__mode" aria-hidden="true">{t.announce.removeBanner}</span>
        <button type="button" class="tool tool--ult" data-action="ultimate" aria-disabled="true" aria-keyshortcuts="U">
          <Icon name="bolt" />
          <span class="tool__label" data-slot="ult-name">{t.ui.ultimate}</span>
          <span class="tool__state" data-slot="ult-state">{t.ui.charging}</span>
        </button>
        <div class="hud__status">
          <div class="polls" role="img" aria-label={t.ui.polls} data-slot="polls">
            {Array.from({ length: 5 }).map(() => <span />)}
          </div>
          <div class="wave">
            <span data-slot="wave-label">{t.ui.wave}</span>
            <div class="wave__bar" data-slot="wave-bar"></div>
          </div>
        </div>
        <div class="hud__sys">
          <button type="button" class="icon-btn icon-btn--speed" data-action="speed" data-speed="1" aria-pressed="false" aria-keyshortcuts="F" aria-label={`${t.ui.speed} ×1 (${t.ui.speedNormal})`} title={`${t.ui.speed} ×1 (${t.ui.speedNormal})`}>
            <span data-speed-icon="0.5"><Icon name="slow" /></span>
            <span data-speed-icon="1"><Icon name="play" /></span>
            <span data-speed-icon="2"><Icon name="fast" /></span>
            <span class="speed-badge" data-slot="speed-badge" aria-hidden="true">×1</span>
          </button>
          <button type="button" class="icon-btn" data-action="mute" aria-pressed="false" aria-keyshortcuts="M" aria-label={t.ui.soundOn} title={t.ui.soundOn}>
            <span data-when="off"><Icon name="sound" /></span>
            <span data-when="on"><Icon name="muted" /></span>
          </button>
          <button type="button" class="icon-btn" data-action="fullscreen" aria-label={t.ui.fullscreen} title={t.ui.fullscreen}>
            <Icon name="fullscreen" />
          </button>
          <button type="button" class="icon-btn" data-action="pause" aria-keyshortcuts="P" aria-label={t.ui.pause} title={t.ui.pause}>
            <Icon name="pause" />
          </button>
        </div>
      </div>
      <p class="hud__info" data-slot="info">{t.ui.howTo}</p>
    </div>

    <div class="stage" data-slot="stage">
      <!-- The whole scene. On a desktop it fills the board; the phone layout crops the
           scenery around the courtyard so that the squares get bigger (see game.css). -->
      <div class="stage__view">
        <canvas data-slot="canvas" width="1280" height="720" aria-hidden="true"></canvas>
        <div class="grid" role="group" aria-label={t.ui.board} data-slot="grid">
          {
            cells.map(({ lane, col }) => (
              <button
                type="button"
                data-cell
                tabindex="-1"
                aria-label={`${fmt(t.ui.rowLabel, { row: lane + 1, col: col + 1 })} : ${t.ui.empty}`}
              />
            ))
          }
        </div>
      </div>

      <div class="overlay" data-overlay="pause" role="dialog" aria-modal="true" aria-labelledby="pause-title" hidden>
        <div class="panel">
          <h2 id="pause-title">{t.ui.paused}</h2>
          <button type="button" class="btn btn--primary" data-action="resume">{t.ui.resume}</button>
          <button type="button" class="btn" data-action="restart">{t.ui.restart}</button>
          <button type="button" class="btn btn--ghost" data-action="quit">{t.ui.quit}</button>
          <!-- Phones only: landscape is forced by default, and can be released here. -->
          <button type="button" class="btn btn--toggle" data-action="orientation" aria-pressed="true">
            <Icon name="phone" /><span>{t.ui.forceLandscape}</span>
          </button>
          <button type="button" class="btn btn--toggle btn--music" data-action="music" aria-pressed="true">
            <span>{t.ui.musicOn}</span>
          </button>
          <!-- Keyboard only: the shortcuts, which no longer fit under a full-screen board. -->
          <div class="panel__keys">
            <p class="panel__keys-title">{t.ui.keyboardTitle}</p>
            <p>{t.ui.keyboardHelp}</p>
          </div>
        </div>
      </div>

      <!-- The first time a special opponent turns up, the match stops for a short introduction. -->
      <div class="overlay" data-overlay="intro" role="dialog" aria-modal="true" aria-labelledby="intro-title" aria-describedby="intro-desc" hidden>
        <div class="panel intro">
          <p class="intro__tag" data-slot="intro-tag">{t.ui.newOpponent}</p>
          <div class="intro__art" data-slot="intro-art" aria-hidden="true"></div>
          <div class="intro__text">
            <h2 id="intro-title" data-slot="intro-name"></h2>
            <p class="intro__power" data-slot="intro-power"></p>
            <p id="intro-desc" data-slot="intro-desc"></p>
          </div>
          <button type="button" class="btn btn--primary" data-action="intro-ok">{t.ui.gotIt}</button>
        </div>
      </div>

      <div class="overlay" data-overlay="result" role="dialog" aria-modal="true" aria-labelledby="result-title" hidden>
        <div class="gazette">
          <p class="gazette__mast">{t.ui.gazette}</p>
          <p class="gazette__tag">{t.ui.gazetteTag}</p>
          <h2 id="result-title" class="gazette__headline" data-slot="headline"></h2>
          <p class="gazette__stars" role="img" data-slot="stars"></p>
          <dl class="gazette__stats" data-slot="stats"></dl>
          <p class="gazette__unlock" data-slot="unlock" hidden></p>
          <p class="gazette__notes" data-slot="notes" hidden></p>
          <div class="gazette__actions">
            <button type="button" class="btn btn--primary" data-action="next">{t.ui.nextLevel}</button>
            <button type="button" class="btn" data-action="duel-pass" hidden>{t.ui.duelPass}</button>
            <button type="button" class="btn btn--share" data-action="share"><Icon name="share" /><span>{t.ui.share}</span></button>
            <button type="button" class="btn" data-action="retry">{t.ui.tryAgain}</button>
            <button type="button" class="btn btn--ghost" data-action="calendar">{t.ui.backToCalendar}</button>
          </div>
        </div>
      </div>
    </div>
    <!-- Two players on one screen: the attacker's side (keyboard on the left, or these buttons). -->
    <div class="versus" data-slot="versus" hidden>
      <p class="versus__budget"><span>{t.ui.versusBudget}</span> <b data-slot="vs-budget">0</b></p>
      <div class="versus__kinds" role="group" aria-label={t.ui.versusKinds}>
        {
          kinds.map((k, i) => (
            <button type="button" class="versus__kind" data-kind={k} aria-pressed={i === 0 ? 'true' : 'false'}>
              <span class="versus__key" aria-hidden="true">{kindKeys[i]}</span>
              <span class="versus__name">{kindName(k)}</span>
              <span class="versus__cost">{VERSUS_KINDS[k]}</span>
            </button>
          ))
        }
      </div>
      <div class="versus__lanes" role="group" aria-label={t.ui.versusLanes}>
        {
          [0, 1, 2, 3, 4].map((lane) => (
            <button type="button" class="versus__lane" data-lane={lane}>
              <span class="versus__key" aria-hidden="true">{laneKeys[lane]}</span>
              <span>{t.ui.versusLane.replace('{n}', String(lane + 1))}</span>
            </button>
          ))
        }
      </div>
      <p class="versus__help">{t.ui.versusKeys.replace('{kinds}', t.ui.versusKindKeys).replace('{lanes}', t.ui.versusLaneKeys)}</p>
    </div>
    <p class="match__help">{t.ui.keyboardHelp}</p>
  </section>

  <p class="sr-only" role="status" aria-live="polite" data-slot="live"></p>
  <p class="sr-only" role="alert" aria-live="assertive" data-slot="alert"></p>
</div>

<script>
  import { boot } from '../game/main';
  boot();
</script>
