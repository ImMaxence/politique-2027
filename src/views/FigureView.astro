---
/** One named figure: portrait, power, catchphrases, numbers and where to meet them. */
import Puppet from '../components/Puppet.astro';
import { LEVELS } from '../game/data/levels';
import type { CampId } from '../game/data/types';
import { CREDITS } from '../game/data/photos';
import { CAMPS, EXTRAS, UNITS, categoryOf } from '../game/data/units';
import { GAME_STRINGS, fmt, type Lang } from '../i18n/game';
import { PAGE_STRINGS } from '../i18n/pages';
import { absolute, otherLang, path } from '../i18n/routes';
import { SITE_STRINGS } from '../i18n/site';
import Base from '../layouts/Base.astro';
import { figureImage, figurePath, nightPath } from '../lib/pages';

interface Props {
  lang: Lang;
  id: string;
}

const { lang, id } = Astro.props;
const g = GAME_STRINGS[lang];
const p = PAGE_STRINGS[lang].figure;
const t = SITE_STRINGS[lang];
const text = g.figures[id];
const unit = UNITS[id];
const guest = EXTRAS[id];
const camp = unit && unit.camp !== 'neutre' ? (unit.camp as CampId) : null;
const photos = CREDITS.filter((c) => c.id === id);
const unlockedAt = unit ? LEVELS.find((l) => l.slots > unit.slot) : undefined;
const nights = guest ? LEVELS.filter((l) => l.guests?.includes(id)) : [];
const only = guest?.onlyAgainst;
const others = camp ? CAMPS[camp].roster.filter((o) => o !== id) : [];

const description = fmt(p.metaDescription, { name: text.name, power: text.power, desc: text.desc });
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'CreativeWork',
    name: fmt(p.metaTitle, { name: text.name, title: text.title }),
    description,
    url: absolute(figurePath(lang, id)),
    image: absolute(figureImage(id)),
    inLanguage: lang,
    genre: 'Satire',
    about: { '@type': 'Person', name: text.name },
    isPartOf: { '@type': 'VideoGame', name: 'Politique 2027', url: absolute(path(lang, 'play')) },
  },
];
---

<Base
  lang={lang}
  route="characters"
  jsonLd={jsonLd}
  page={{
    title: fmt(p.metaTitle, { name: text.name, title: text.title }),
    description,
    path: figurePath(lang, id),
    altPath: figurePath(otherLang(lang), id),
    image: figureImage(id),
    imageAlt: text.name,
    crumbs: [
      { name: t.labels.home, path: path(lang, 'home') },
      { name: t.labels.characters, path: path(lang, 'characters') },
      { name: text.name, path: figurePath(lang, id) },
    ],
  }}
>
  <div class="container page-head">
    <nav class="breadcrumb" aria-label="Breadcrumb">
      <ol>
        <li><a href={path(lang, 'home')}>{t.labels.home}</a></li>
        <li><a href={path(lang, 'characters')}>{t.labels.characters}</a></li>
        <li aria-current="page">{text.name}</li>
      </ol>
    </nav>
  </div>

  <article class="container figure-page" data-camp={camp ?? undefined}>
    <div class="figure-page__art">
      <Puppet id={id} uid="page" size={240} />
    </div>
    <div class="figure-page__body">
      <p class="figure-card__party">
        {text.party}{camp && <> · {g.camps[camp].name}</>}{(unit?.boss || guest?.boss) && <> · {p.boss}</>}{guest && !camp && <> · {p.guest}</>}
      </p>
      <h1>{text.name}</h1>
      <p class="figure-page__title">{text.title}</p>
      <p class="figure-page__power"><b>{text.power}</b> — {text.desc}</p>
      {text.boss && <p class="figure-page__boss">{text.boss}</p>}

      <h2>{p.lines}</h2>
      <ul class="figure-page__lines" role="list">{text.lines.map((line) => <li>« {line} »</li>)}</ul>

      <h2>{p.stats}</h2>
      <ul class="stats">
        {unit && <li class="stats__type" data-type={categoryOf(unit)}>{g.types[categoryOf(unit)]}</li>}
        {unit && <li>{p.cost} : {unit.cost}</li>}
        {unit && <li>{p.credibility} : {unit.hp}</li>}
        {unit && <li>{p.recharge} : {unit.recharge} {p.seconds}</li>}
        {unlockedAt && <li>{fmt(p.unlocked, { night: g.levels[unlockedAt.id].name })}</li>}
        {
          nights.length > 0 && (
            <li>
              {fmt(p.guestOf, { nights: '' })}
              {nights.map((n, i) => (
                <>
                  {i > 0 && ', '}
                  <a href={nightPath(lang, n.id)}>{g.levels[n.id].name}</a>
                </>
              ))}
              {only && <> ({fmt(p.onlyAgainst, { camp: g.camps[only].name })})</>}
            </li>
          )
        }
      </ul>

      {
        camp && (
          <p class="trump">
            <small>{p.trump}</small>
            <b>{g.ultimates[CAMPS[camp].ultimate].name}</b>
            {g.ultimates[CAMPS[camp].ultimate].desc}
          </p>
        )
      }

      <p class="figure-page__cta">
        <a class="btn btn--primary" href={path(lang, 'play')}>{camp ? fmt(p.play, { camp: g.camps[camp].name }) : t.characters.cta}</a>
      </p>
      <p class="figure-page__satire">{p.satire} <a href={path(lang, 'legal')}>{p.legal}</a></p>
      {
        photos.length > 0 && (
          <p class="figure-page__credit">
            {p.photo}{' '}
            {photos.map((c, i) => (
              <>
                {i > 0 && ' · '}
                <a href={c.source} rel="noopener">{c.author}</a>, {c.license}
              </>
            ))}
            {' '}{p.photoNote}
          </p>
        )
      }
    </div>
  </article>

  {
    others.length > 0 && camp && (
      <section class="container section figure-others" aria-labelledby="others-title">
        <h2 id="others-title">{p.others} — {g.camps[camp].name}</h2>
        <ul class="figure-others__list" role="list">
          {others.map((o) => (
            <li>
              <a href={figurePath(lang, o)}>
                <Puppet id={o} uid={`other-${o}`} size={72} />
                <span>{g.figures[o].name}</span>
              </a>
            </li>
          ))}
        </ul>
      </section>
    )
  }
</Base>
