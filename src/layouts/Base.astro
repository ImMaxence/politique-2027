---
import '@fontsource/anton/index.css';
import '@fontsource-variable/public-sans/index.css';
import '../styles/global.css';
// The two Latin faces every page uses, fetched before the stylesheet asks for them:
// the headings no longer jump when the display font arrives.
import antonLatin from '@fontsource/anton/files/anton-latin-400-normal.woff2?url';
import publicSansLatin from '@fontsource-variable/public-sans/files/public-sans-latin-wght-normal.woff2?url';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE } from '../config/site';
import type { Lang } from '../i18n/game';
import { absolute, otherLang, path, type RouteKey } from '../i18n/routes';
import { SITE_STRINGS } from '../i18n/site';

interface Props {
  lang: Lang;
  route: RouteKey;
  /** Extra schema.org objects for this page (the Person/WebSite graph is added automatically). */
  jsonLd?: Record<string, unknown>[];
  /** A page outside the fixed routes (a figure, a night): its own title, address, alternate and picture. */
  page?: {
    title: string;
    description: string;
    path: string;
    altPath: string;
    image?: string;
    imageAlt?: string;
    crumbs: { name: string; path: string }[];
  };
}

const { lang, route, jsonLd = [], page } = Astro.props;
const t = SITE_STRINGS[lang];
const meta = page ?? t.meta[route];
const url = absolute(page ? page.path : path(lang, route));
const other = otherLang(lang);
const altUrl = absolute(page ? page.altPath : path(other, route));
const frUrl = lang === 'fr' ? url : altUrl;
const image = absolute(page?.image ?? '/og.png');
const imageAlt = page?.imageAlt ?? t.home.lead;

const crumbs = page ? page.crumbs : route === 'home' ? [] : [{ name: t.labels.home, path: path(lang, 'home') }, { name: t.labels[route], path: path(lang, route) }];
const breadcrumb = crumbs.length
  ? [
      {
        '@context': 'https://schema.org',
        '@type': 'BreadcrumbList',
        itemListElement: crumbs.map((crumb, index) => ({ '@type': 'ListItem', position: index + 1, name: crumb.name, item: absolute(crumb.path) })),
      },
    ]
  : [];
const structured = [...breadcrumb, ...jsonLd];
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="color-scheme" content="dark" />
    <link rel="preload" href={antonLatin} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={publicSansLatin} as="font" type="font/woff2" crossorigin />
    <title>{meta.title}</title>
    <meta name="description" content={meta.description} />
    <meta name="author" content={SITE.author.name} />
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1" />
    <link rel="canonical" href={url} />
    <link rel="alternate" hreflang={lang} href={url} />
    <link rel="alternate" hreflang={other} href={altUrl} />
    <link rel="alternate" hreflang="x-default" href={frUrl} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={meta.title} />
    <meta property="og:description" content={meta.description} />
    <meta property="og:url" content={url} />
    <meta property="og:locale" content={t.locale} />
    <meta property="og:locale:alternate" content={SITE_STRINGS[other].locale} />
    <meta property="og:image" content={image} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={imageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={meta.title} />
    <meta name="twitter:description" content={meta.description} />
    <meta name="twitter:image" content={image} />

    <meta name="theme-color" content={SITE.themeColor} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <!-- Installed on an iPhone home screen: full screen, under a dark status bar. -->
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black" />
    <meta name="apple-mobile-web-app-title" content={SITE.name} />
    <link rel="alternate" type="text/plain" href="/llms.txt" title="llms.txt" />

    {structured.map((data) => <script is:inline type="application/ld+json" set:html={JSON.stringify(data)} />)}
  </head>
  <body id="top">
    <a class="skip" href="#main">{t.nav.skip}</a>
    <Header lang={lang} route={route} altHref={page?.altPath} />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer lang={lang} />
  </body>
</html>
