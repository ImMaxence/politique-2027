---
import '@fontsource/anton/index.css';
import '@fontsource-variable/public-sans/index.css';
import '../styles/global.css';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE } from '../config/site';
import type { Lang } from '../i18n/game';
import { absolute, otherLang, path, type RouteKey } from '../i18n/routes';
import { SITE_STRINGS } from '../i18n/site';

interface Props {
  lang: Lang;
  route: RouteKey;
  /** Extra schema.org objects for this page (the Person/WebSite graph is added automatically). */
  jsonLd?: Record<string, unknown>[];
}

const { lang, route, jsonLd = [] } = Astro.props;
const t = SITE_STRINGS[lang];
const meta = t.meta[route];
const url = absolute(path(lang, route));
const other = otherLang(lang);
const image = absolute('/og.png');

const breadcrumb =
  route === 'home'
    ? []
    : [
        {
          '@context': 'https://schema.org',
          '@type': 'BreadcrumbList',
          itemListElement: [
            { '@type': 'ListItem', position: 1, name: t.labels.home, item: absolute(path(lang, 'home')) },
            { '@type': 'ListItem', position: 2, name: t.labels[route], item: url },
          ],
        },
      ];
const structured = [...breadcrumb, ...jsonLd];
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline src="/theme.js"></script>
    <title>{meta.title}</title>
    <meta name="description" content={meta.description} />
    <meta name="author" content={SITE.author.name} />
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1" />
    <link rel="canonical" href={url} />
    <link rel="alternate" hreflang={lang} href={url} />
    <link rel="alternate" hreflang={other} href={absolute(path(other, route))} />
    <link rel="alternate" hreflang="x-default" href={absolute(path('fr', route))} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={meta.title} />
    <meta property="og:description" content={meta.description} />
    <meta property="og:url" content={url} />
    <meta property="og:locale" content={t.locale} />
    <meta property="og:locale:alternate" content={SITE_STRINGS[other].locale} />
    <meta property="og:image" content={image} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={t.home.lead} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={meta.title} />
    <meta name="twitter:description" content={meta.description} />
    <meta name="twitter:image" content={image} />

    <meta name="theme-color" content={SITE.themeColor.light} media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content={SITE.themeColor.dark} media="(prefers-color-scheme: dark)" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="alternate" type="text/plain" href="/llms.txt" title="llms.txt" />

    {structured.map((data) => <script is:inline type="application/ld+json" set:html={JSON.stringify(data)} />)}
  </head>
  <body id="top">
    <a class="skip" href="#main">{t.nav.skip}</a>
    <Header lang={lang} route={route} />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer lang={lang} />
  </body>
</html>
